# Copy to server/.env and fill in. Never commit the real .env — it is gitignored.

# --- Required ---------------------------------------------------------------

# MongoDB Atlas connection string (Database > Connect > Drivers).
# Remember to URL-encode special characters in the password, and to append the
# database name before the query string.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/crm?retryWrites=true&w=majority

# Signing key for auth tokens. Must be at least 32 chars — the server refuses
# to start otherwise. Generate with:
#   openssl rand -base64 48
JWT_SECRET=

# --- Optional ---------------------------------------------------------------

PORT=5000
NODE_ENV=production

# Only needed if the frontend is served from a DIFFERENT origin than the API.
# When nginx serves both from one domain (the default setup), leave this empty.
# Comma-separated, no trailing slashes:
#   CORS_ORIGINS=https://crm.example.com,https://www.crm.example.com
CORS_ORIGINS=

# Google Gemini key, for the AI insights and natural-search endpoints.
# Billed by Google, separate from AWS. Omit it and those routes will fail,
# but the rest of the app works.
GEMINI_API_KEY=
