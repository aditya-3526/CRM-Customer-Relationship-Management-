# Copy to .env.local for local development.
#
# IMPORTANT: Create React App inlines these at BUILD time, not runtime. Changing
# this value requires a rebuild — you cannot swap it on the server afterwards.
# Only variables prefixed REACT_APP_ are exposed to the bundle.
#
# Anything here ends up readable in the shipped JavaScript. Never put secrets in
# this file — no API keys, no credentials.

# Local development: point at your local server. Must match server/.env PORT.
REACT_APP_API_BASE_URL=http://localhost:5000/api

# Production: leave this UNSET. The app then defaults to the relative path
# '/api', which nginx proxies to Node on the same origin. That avoids CORS and
# keeps the bundle portable across domains.
